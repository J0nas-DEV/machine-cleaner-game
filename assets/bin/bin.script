function init(self)
    msg.post(".", "acquire_input_focus")

    self.speed = 500

    self.left = false
    self.right = false

    self.moving = false
    self.rail_playing = false
end


local function update_effects(self)

    local moving_now = self.left or self.right

    -- Particle ON while moving
    if moving_now and not self.moving then
        particlefx.play("#muzzle")
        self.moving = true

    elseif not moving_now and self.moving then
        particlefx.stop("#muzzle")
        self.moving = false
    end


    -- Rail sound ON while moving
    if moving_now and not self.rail_playing then
        msg.post("#rail_sound", "play_sound")
        self.rail_playing = true

    elseif not moving_now and self.rail_playing then
        msg.post("#rail_sound", "stop_sound")
        self.rail_playing = false
    end
end


function on_input(self, action_id, action)

    if action_id == hash("left") then
        if action.pressed or action.repeated then
            self.left = true
        elseif action.released then
            self.left = false
        end
    end


    if action_id == hash("right") then
        if action.pressed or action.repeated then
            self.right = true
        elseif action.released then
            self.right = false
        end
    end

    update_effects(self)
end


function update(self, dt)
    local pos = go.get_position()

    if self.left then
        pos.x = pos.x - self.speed * dt
    end

    if self.right then
        pos.x = pos.x + self.speed * dt
    end

    go.set_position(pos)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("fart") then
        msg.post("#fart", "play_sound")
    elseif message_id == hash("metal") then
        msg.post("#metal", "play_sound")
    end
end
